# Flask runtime
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true
PORT=8000

# Production database: prefer DATABASE_URL on the EC2 host
DATABASE_URL=mysql+pymysql://portfolio_user:replace-password@127.0.0.1:3306/portfolio_db

# Local development fallback (used only when DATABASE_URL is not set)
LOCAL_DB_USER=root
LOCAL_DB_PASS=
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_NAME=portfolio_db

# Host-mounted persistence directories inside the container
UPLOAD_FOLDER=/app/static/uploads
RESUME_FOLDER=/app/static/resume
